# Slack app credentials — from api.slack.com/apps → your app
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Anthropic — platform.claude.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Bolna — platform.bolna.ai → Developers. Keep this secret: anyone with it
# can read your account data and place calls that spend your balance.
BOLNA_API_KEY=bn-...

# Optional: override the model (defaults to claude-opus-5 in src/app.js)
# ANTHROPIC_MODEL=claude-opus-5

# Only needed on a host with an ephemeral disk (e.g. Render's free plan), where
# data/user-bolna-keys.json is wiped on every restart. One-line JSON of that
# file's contents; it seeds the registrations at boot so FDEs stay connected.
# USER_KEYS_JSON={"U123":"bn-..."}
